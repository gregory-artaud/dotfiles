# CachyOS provides oh-my-zsh, completions, suggestions and Powerlevel10k.
plugins=(git fzf extract)
source /usr/share/cachyos-zsh-config/cachyos-config.zsh

typeset -U path
path=("$HOME/.local/bin" $path)
export EDITOR=nvim
export VISUAL=nvim
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
    source "$NVM_DIR/nvm.sh"
fi
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$UID}/dotfiles-ssh-agent.socket"
if [[ -t 0 ]]; then
    export GPG_TTY=$(tty)
fi
export YAZI_IMAGE_BACKEND=ueberzugpp

alias vim="nvim"
alias vi="nvim"
alias gdh="git diff HEAD"
alias dcu="docker compose up"
alias dcud="docker compose up -d"
alias zshconfig="vim ~/.zshrc"
alias nvimconfig="nvim ~/.config/nvim/"
alias gcob="git checkout -b"
alias grm="git rm --cached"
alias gwd="git rev-parse --abbrev-ref HEAD"
alias xclip='xclip -selection clipboard'
alias code='zeditor'
alias z="zeditor"
alias pnr='pnpm run "$(jq -r ".scripts | keys[]" package.json | fzf)"'
alias slugify='f(){ printf "%s\n" "$1" | tr "[:upper:]" "[:lower:]" | sed -E "s/[^a-z0-9]+/-/g; s/^-+|-+$//g"; }; f'
alias lsf='ls | fzf'
alias oc='codex'
alias c='clear -x'

gwtr() {
  git worktree list \
  | fzf -m \
  | awk '{print $1}' \
  | while read -r wt; do
      git worktree remove --force "$wt" && echo "Deleted worktree: $wt"
    done
}


bindkey -r '^J'
bindkey '^H' backward-kill-word
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
