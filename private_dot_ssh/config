Include config.d/*

Host *
    IdentityAgent /run/user/%i/dotfiles-ssh-agent.socket

Host github.com
    User git
    HostName github.com
    IdentityFile ~/.ssh/id_github
    IdentitiesOnly yes
    AddKeysToAgent yes

Host home_lab
    User gartaud
    HostName 192.168.1.134
    IdentityFile ~/.ssh/id_home_lab
    IdentitiesOnly yes
    AddKeysToAgent yes
